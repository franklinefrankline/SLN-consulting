# ================================================================
# SLN Consulting Website - Email Service Environment Variables
#
# Configure these variables in:
# 1. Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# 2. Or locally: copy this file to .env (do NOT commit .env to git)
# ================================================================

# ----------------------------------------------------------------
# OPTION 1: Resend (RECOMMENDED FOR VERCEL)
# Free 3,000 emails/month. Instant HTTPS API, zero SMTP issues.
# 1. Sign up at https://resend.com
# 2. Create an API Key in your Resend Dashboard.
# 3. Add RESEND_API_KEY below.
# ----------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
# Optional custom sender once domain is verified in Resend:
# MAIL_FROM=SLN Consulting <notifications@slnconsulting.co.in>


# ----------------------------------------------------------------
# OPTION 2: Authenticated SMTP (Google Workspace / Office 365 / cPanel)
# If using Gmail, generate an "App Password" (requires 2FA enabled).
# ----------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@slnconsulting.co.in
# SMTP_PASS=your-16-character-app-password
# SMTP_SECURE=tls
# SMTP_FROM=SLN Consulting <your-email@slnconsulting.co.in>


# ----------------------------------------------------------------
# OPTION 3: SendGrid
# ----------------------------------------------------------------
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# MAIL_FROM=SLN Consulting <notifications@slnconsulting.co.in>


# ----------------------------------------------------------------
# RECIPIENTS (Optional: defaults to both addresses below)
# ----------------------------------------------------------------
# RECIPIENT_EMAIL=srinivas.c@slnconsulting.co.in,schakravarthy@hotmail.com
