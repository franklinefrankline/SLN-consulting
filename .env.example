# ================================================================
# SLN Consulting Website - Email Service Environment Variables
#
# Configure these variables in:
# 1. Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# 2. Or locally: copy this file to .env (do NOT commit .env to git)
# ================================================================

# ----------------------------------------------------------------
# OPTION 1: GoDaddy Webmail / Professional Email SMTP (RECOMMENDED)
# Verified settings for slnconsulting.co.in (GoDaddy secureserver.net)
# ----------------------------------------------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=srinivas.c@slnconsulting.co.in
SMTP_PASS=your_godaddy_email_password_here
SMTP_FROM=srinivas.c@slnconsulting.co.in
RECIPIENT_EMAIL=srinivas.c@slnconsulting.co.in


# ----------------------------------------------------------------
# OPTION 2: Resend API (Alternative for serverless platforms like Vercel)
# ----------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# MAIL_FROM=SLN Consulting <notifications@slnconsulting.co.in>


# ----------------------------------------------------------------
# OPTION 3: SendGrid API (Alternative)
# ----------------------------------------------------------------
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# MAIL_FROM=SLN Consulting <notifications@slnconsulting.co.in>
